{
  "name": "ai-rulebook",
  "displayName": "AI Rulebook",
  "description": "AI Rulebook — install and manage focused, always-on engineering rules for Cursor, with optional Cline, opencode, and Claude Code sync.",
  "version": "2.8.0",
  "publisher": "WyvernSystemsLLC",
  "license": "MIT",
  "icon": "icon.png",
  "homepage": "https://github.com/wyvernsystems/ai-rulebook-vscode-extension#readme",
  "bugs": {
    "url": "https://github.com/wyvernsystems/ai-rulebook-vscode-extension/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/wyvernsystems/ai-rulebook-vscode-extension.git"
  },
  "keywords": [
    "cursor",
    "cursor-rules",
    "ai",
    "ai-agent",
    "ai-rules",
    "rules",
    "rulebook",
    "cline",
    "opencode",
    "claude-code",
    "prompt-engineering",
    "code-assistant"
  ],
  "engines": {
    "vscode": "^1.85.0",
    "node": ">=18.18.0"
  },
  "categories": [
    "Other",
    "Snippets"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "aiRules.installWorkspace",
        "title": "AI Rulebook: Install / update rule pack",
        "category": "AI Rulebook"
      },
      {
        "command": "aiRules.enableCoreWorkspace",
        "title": "AI Rulebook: Enable all rules (workspace)",
        "category": "AI Rulebook"
      },
      {
        "command": "aiRules.disableCoreWorkspace",
        "title": "AI Rulebook: Disable all rules (workspace)",
        "category": "AI Rulebook"
      },
      {
        "command": "aiRules.enableRuleWorkspace",
        "title": "AI Rulebook: Enable one rule…",
        "category": "AI Rulebook"
      },
      {
        "command": "aiRules.disableRuleWorkspace",
        "title": "AI Rulebook: Disable one rule…",
        "category": "AI Rulebook"
      },
      {
        "command": "aiRules.syncClineWorkspace",
        "title": "AI Rulebook: Sync rule pack to Cline",
        "category": "AI Rulebook"
      },
      {
        "command": "aiRules.syncCursorWorkspace",
        "title": "AI Rulebook: Sync rule pack to Cursor",
        "category": "AI Rulebook"
      },
      {
        "command": "aiRules.syncOpencodeWorkspace",
        "title": "AI Rulebook: Sync rule pack to opencode",
        "category": "AI Rulebook"
      },
      {
        "command": "aiRules.syncClaudeWorkspace",
        "title": "AI Rulebook: Sync rule pack to Claude Code",
        "category": "AI Rulebook"
      },
      {
        "command": "aiRules.syncAllFormatsWorkspace",
        "title": "AI Rulebook: Sync rule pack to all formats",
        "category": "AI Rulebook"
      },
      {
        "command": "aiRules.removeCursorWorkspace",
        "title": "AI Rulebook: Remove Cursor rule pack",
        "category": "AI Rulebook"
      },
      {
        "command": "aiRules.removeClineWorkspace",
        "title": "AI Rulebook: Remove Cline rule pack",
        "category": "AI Rulebook"
      },
      {
        "command": "aiRules.removeOpencodeWorkspace",
        "title": "AI Rulebook: Remove opencode rule pack",
        "category": "AI Rulebook"
      },
      {
        "command": "aiRules.removeClaudeWorkspace",
        "title": "AI Rulebook: Remove Claude Code rule pack",
        "category": "AI Rulebook"
      },
      {
        "command": "aiRules.removeAllFormatsWorkspace",
        "title": "AI Rulebook: Remove all rule packs",
        "category": "AI Rulebook"
      },
      {
        "command": "aiRules.showCoreStatus",
        "title": "AI Rulebook: Show rule pack status",
        "category": "AI Rulebook"
      },
      {
        "command": "aiRules.hideRuleColors",
        "title": "AI Rulebook: Hide rule colors",
        "category": "AI Rulebook"
      },
      {
        "command": "aiRules.resetWorkspaceRulesToDefaults",
        "title": "AI Rulebook: Reset rule pack to defaults…",
        "category": "AI Rulebook"
      },
      {
        "command": "aiRules.refreshTree",
        "title": "AI Rulebook: Refresh sidebar",
        "category": "AI Rulebook",
        "icon": "$(refresh)"
      },
      {
        "command": "aiRules.revealRuleFile",
        "title": "AI Rulebook: Open rule file",
        "category": "AI Rulebook"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "aiRulesSidebar",
          "title": "AI Rulebook",
          "icon": "$(checklist)"
        }
      ]
    },
    "views": {
      "aiRulesSidebar": [
        {
          "id": "aiRules.rulesTree",
          "name": "Rule Pack",
          "icon": "$(checklist)",
          "contextualTitle": "AI Rulebook"
        }
      ]
    },
    "submenus": [
      {
        "id": "aiRules.syncSubmenu",
        "label": "Sync rule packs"
      },
      {
        "id": "aiRules.removeSubmenu",
        "label": "Remove rule packs"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "aiRules.refreshTree",
          "when": "view == aiRules.rulesTree",
          "group": "navigation@9"
        },
        {
          "command": "aiRules.enableCoreWorkspace",
          "when": "view == aiRules.rulesTree",
          "group": "1_state@1"
        },
        {
          "command": "aiRules.disableCoreWorkspace",
          "when": "view == aiRules.rulesTree",
          "group": "1_state@2"
        },
        {
          "command": "aiRules.installWorkspace",
          "when": "view == aiRules.rulesTree",
          "group": "2_workspace@1"
        },
        {
          "command": "aiRules.resetWorkspaceRulesToDefaults",
          "when": "view == aiRules.rulesTree",
          "group": "2_workspace@2"
        },
        {
          "submenu": "aiRules.syncSubmenu",
          "when": "view == aiRules.rulesTree",
          "group": "4_sync@1"
        },
        {
          "submenu": "aiRules.removeSubmenu",
          "when": "view == aiRules.rulesTree",
          "group": "5_remove@1"
        },
        {
          "command": "aiRules.showCoreStatus",
          "when": "view == aiRules.rulesTree",
          "group": "3_inspect@1"
        },
        {
          "command": "aiRules.hideRuleColors",
          "when": "view == aiRules.rulesTree",
          "group": "3_inspect@2"
        }
      ],
      "aiRules.syncSubmenu": [
        {
          "command": "aiRules.syncAllFormatsWorkspace",
          "group": "1_all@1"
        },
        {
          "command": "aiRules.syncCursorWorkspace",
          "group": "2_format@1"
        },
        {
          "command": "aiRules.syncClineWorkspace",
          "group": "2_format@2"
        },
        {
          "command": "aiRules.syncOpencodeWorkspace",
          "group": "2_format@3"
        },
        {
          "command": "aiRules.syncClaudeWorkspace",
          "group": "2_format@4"
        }
      ],
      "aiRules.removeSubmenu": [
        {
          "command": "aiRules.removeAllFormatsWorkspace",
          "group": "1_all@1"
        },
        {
          "command": "aiRules.removeCursorWorkspace",
          "group": "2_format@1"
        },
        {
          "command": "aiRules.removeClineWorkspace",
          "group": "2_format@2"
        },
        {
          "command": "aiRules.removeOpencodeWorkspace",
          "group": "2_format@3"
        },
        {
          "command": "aiRules.removeClaudeWorkspace",
          "group": "2_format@4"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "aiRules.rulesTree",
        "contents": "Open a project folder to install and manage its AI rule pack.\n[Open Folder](command:workbench.action.files.openFolder)",
        "when": "workspaceFolderCount == 0"
      }
    ],
    "colors": [
      {
        "id": "aiRulebook.activeForeground",
        "description": "Foreground color for enabled rules.",
        "defaults": {
          "dark": "#3FB950",
          "light": "#1A7F37",
          "highContrast": "#2EA043"
        }
      },
      {
        "id": "aiRulebook.inactiveForeground",
        "description": "Foreground color for disabled rules.",
        "defaults": {
          "dark": "#F85149",
          "light": "#CF222E",
          "highContrast": "#F85149"
        }
      }
    ],
    "configuration": {
      "title": "AI Rulebook",
      "properties": {
        "aiRules.autoInstallOnOpenWorkspace": {
          "type": "boolean",
          "default": true,
          "description": "When opening a workspace that has no .cursor/rules/ai-rules folder yet, install the bundled rule pack automatically. Existing rules folders are never overwritten."
        },
        "aiRules.installCursorRulesFolder": {
          "type": "string",
          "enum": [
            "auto",
            "always",
            "never"
          ],
          "enumDescriptions": [
            "Auto-install .cursor/rules/ai-rules/ only when the host application is Cursor (recommended).",
            "Always auto-install .cursor/rules/ai-rules/, even in plain VS Code (useful when committing rules for Cursor-using teammates).",
            "Never auto-install .cursor/rules/ai-rules/. Manual install / reset / sidebar commands still work."
          ],
          "default": "auto",
          "description": "Policy for auto-creating .cursor/rules/ai-rules/ when the folder is missing. Manual commands ignore this setting. Cline mirroring (.clinerules/ai-rules/) is gated separately by aiRules.autoSyncClineWhenInstalled and the Cline-installed check."
        },
        "aiRules.colorRulesInExplorer": {
          "type": "boolean",
          "default": true,
          "description": "Tint rule files in VS Code's Explorer: `.mdc` files (active) appear green and `.mdc.disabled` files (off) appear muted gray, anywhere under `.cursor/rules/ai-rules/` in the open workspace."
        },
        "aiRules.promptInstallOnUpdate": {
          "type": "boolean",
          "default": true,
          "description": "When the extension version changes, offer to refresh workspace rules from the bundled copy."
        },
        "aiRules.autoSyncClineWhenInstalled": {
          "type": "boolean",
          "default": true,
          "description": "When Cline is installed, automatically mirror the rule pack into .clinerules/ai-rules/ after install or reset and when Cline is first detected."
        },
        "aiRules.autoSyncOpencodeWhenInstalled": {
          "type": "boolean",
          "default": true,
          "description": "When the workspace shows evidence of opencode usage (an AGENTS.md, an opencode.json/opencode.jsonc, or a .opencode/ folder), automatically mirror the rule pack into .opencode/rules/ai-rules/ and register it in the opencode config's instructions array after install or reset."
        },
        "aiRules.autoSyncClaudeWhenInstalled": {
          "type": "boolean",
          "default": true,
          "description": "When the workspace shows evidence of Claude Code usage (a CLAUDE.md, a CLAUDE.local.md, or a .claude/ folder), automatically mirror the rule pack into .claude/rules/ai-rules/ after install or reset. Claude Code auto-discovers every .md file under .claude/rules/, so no config file is touched."
        }
      }
    }
  },
  "scripts": {
    "sync-bundled": "node scripts/sync-bundled.mjs && node scripts/build-rule-packs.mjs",
    "verify:bundled": "node scripts/verify-bundled.mjs",
    "clean": "node -e \"require('node:fs').rmSync('out', { recursive: true, force: true })\"",
    "compile": "npm run clean && tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && npm run verify:bundled && node --test tests/*.test.mjs",
    "test:coverage": "npm run compile && npm run verify:bundled && node --test --experimental-test-coverage tests/*.test.mjs",
    "vscode:prepublish": "npm run sync-bundled && npm run verify:bundled && npm run compile",
    "package": "vsce package",
    "package-rule-packs": "node scripts/package-rule-packs.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.0",
    "typescript": "^5.4.0"
  }
}
